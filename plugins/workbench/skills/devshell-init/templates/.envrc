# direnv config — drop next to flake.nix in the repo root.
# Run `direnv allow` once. After that the devshell activates on `cd`.
#
# Requires nix-direnv (installed by bootstrap.sh) — without it, every cd into
# the directory re-evaluates the flake, which is slow. nix-direnv caches it.

use flake

# Re-enter the shell when the flake changes.
watch_file flake.nix
watch_file flake.lock

# Secrets: never a committed .env with values in it.
#
# Correct pattern — a .env.template holding only op:// references:
#     AWS_PROFILE=homelab
#     API_TOKEN=op://Private/some-service/credential
# then run commands as:
#     op run --env-file=.env.template -- <command>
#
# dotenv_if_exists .env.template   # references only, never values
