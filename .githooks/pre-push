#!/usr/bin/env bash
# Last local gate: every commit about to leave this machine, its added lines, paths
# and message, plus a gitleaks pass over the same commits.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
command -v gitleaks >/dev/null 2>&1 || {
  echo "pre-push: gitleaks is not installed; install it (brew install gitleaks) and retry." >&2
  exit 1; }
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # deleting a remote ref
  if [ "$remote_sha" = "$zero" ]; then            # new remote branch or tag
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
  else
    base="$remote_sha"
  fi
  if [ -n "$base" ]; then range="$base..$local_sha"; else range="$local_sha"; fi
  echo "pre-push: checking $range for $remote_ref"
  python3 "$root/scripts/brand-gate.py" --range "$range"
  gitleaks git --log-opts="$range" --redact --no-banner "$root"
done
